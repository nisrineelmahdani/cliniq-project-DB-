MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=clinique_bdr
MYSQL_USER=
MYSQL_PASSWORD=

# Explicit fresh development database provisioning (never uses MYSQL_DATABASE).
# The account needs CREATE DATABASE and schema/data privileges for cliniq_dev_* only.
CLINIQ_SETUP_HOST=127.0.0.1
CLINIQ_SETUP_PORT=3306
CLINIQ_SETUP_USER=
CLINIQ_SETUP_PASSWORD=
# CLINIQ_SETUP_UNIX_SOCKET=/tmp/mysql.sock

# Dedicated, pre-provisioned integration database; no CREATE DATABASE required.
# Grant SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, REFERENCES, TRIGGER, INDEX on this database only.
# There is no runtime fallback to application MYSQL_* credentials.
CLINIQ_TEST_HOST=127.0.0.1
CLINIQ_TEST_PORT=3306
CLINIQ_TEST_DATABASE=cliniq_test_dev
CLINIQ_TEST_USER=
CLINIQ_TEST_PASSWORD=
# CLINIQ_TEST_UNIX_SOCKET=/tmp/mysql.sock
# Export these ONLY for an explicitly requested reset/test run:
# CLINIQ_TEST_RESET_CONFIRM=cliniq_test_dev
# CLINIQ_RUN_MYSQL_TESTS=1
# CLINIQ_RUN_DEV003_MYSQL_TESTS=1
# CLINIQ_RUN_DEV004_MYSQL_TESTS=1
# CLINIQ_RUN_DEV005_MYSQL_TESTS=1
# CLINIQ_RUN_DEV006_MYSQL_TESTS=1
# CLINIQ_RUN_DEV007_MYSQL_TESTS=1

# DEV-008: opt in only after administrator-approved trigger creation policy.
# These flags never change global server settings.
# CLINIQ_RUN_DEV008_MYSQL_TESTS=1
# CLINIQ_TEST_SQL_EXTENSIONS=1
